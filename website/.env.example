# Copy to .env and fill in. In PowerShell: $env:DATABASE_URL = '<value>' before runserver.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Password-reset emails (https://resend.com): paste your API key. EMAIL_FROM must use a domain verified in Resend
# (until then onboarding@resend.dev only delivers to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM=Cloud for Kids <onboarding@resend.dev>

# M-Pesa Express (STK Push) for plan payments: create an app at https://developer.safaricom.co.ke.
# Leave the key empty on your own computer to get a "simulate payment" button instead (DEBUG=True only).
# The callback goes to SITE_URL/plans/mpesa/callback/<MPESA_CALLBACK_TOKEN>/, so SITE_URL must be the public https address.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# MPESA_TILL_NUMBER=           # only for a Buy Goods till (MPESA_SHORTCODE is then the store / head office number)
MPESA_CALLBACK_TOKEN=generate-a-long-random-string
# MPESA_ACCOUNT_REFERENCE=CloudForKids   # the account name on the PIN prompt (12 characters at most)
# B2C payouts (Admin > Payouts) and balance checks. Results go to SITE_URL/plans/pay/payout/... and /plans/pay/balance/...
# The security credential is the initiator's password encrypted with Safaricom's certificate (never the plain password).
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# SIBLING_DISCOUNT_PERCENT=10   # discount for a parent's 2nd, 3rd... child (0 turns it off)
# BILLING_KRA_PIN=              # printed on receipts

# Live online classes (https://cloud.livekit.io): create a project, then Settings > Keys. LIVEKIT_URL looks like
# wss://your-project.livekit.cloud. In Settings > Webhooks add SITE_URL/live/webhook/ for attendance and minutes used.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVE_MAX_MINUTES=180          # a class nobody ended counts as over after this long
# LIVE_MAX_PARTICIPANTS=60
# LIVE_CLASSES_REQUIRE_PLAN=False   # True = learners need a plan with "live classes" ticked (Admin > Plans)
# LIVE_BLOCKED_WORDS=word1,word2    # extra words the class chat refuses
# Recordings of the teacher (voice + screen/camera, never learners) go to S3-compatible storage. Leave empty to turn off.
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto. AWS S3: no endpoint, region e.g. eu-west-1.
LIVE_RECORDING_BUCKET=
LIVE_RECORDING_ACCESS_KEY=
LIVE_RECORDING_SECRET=
LIVE_RECORDING_REGION=auto
LIVE_RECORDING_ENDPOINT=

# AI assistant (admins and facilitators): provider keys are added and tested in Admin > Tools > AI assistant, not here.
# Saved keys are encrypted with this secret (or SECRET_KEY when empty). Changing it means re-adding the keys.
# ASSISTANT_KEY_SECRET=generate-a-long-random-string

# --- Production settings (set these as environment variables on your host) ---
DEBUG=False
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=cloudforkids.co.ke,www.cloudforkids.co.ke
CSRF_TRUSTED_ORIGINS=https://cloudforkids.co.ke,https://www.cloudforkids.co.ke
# SECURE_HSTS_SECONDS=31536000   # raise once HTTPS is confirmed working
